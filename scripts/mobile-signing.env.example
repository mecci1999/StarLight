# Copy to scripts/mobile-signing.env (ignored) or provide these through protected CI.
# Do not put credential values, device identifiers, certificates, or profiles in this file.

# Android signed APK
STARLIGHT_ANDROID_KEYSTORE_PATH=
STARLIGHT_ANDROID_KEYSTORE_PASSWORD=
STARLIGHT_ANDROID_KEY_ALIAS=
STARLIGHT_ANDROID_KEY_PASSWORD=

# iOS registered-device archive/export
STARLIGHT_IOS_DEVELOPMENT_TEAM=
STARLIGHT_IOS_CODE_SIGN_IDENTITY=
STARLIGHT_IOS_PROVISIONING_PROFILE_SPECIFIER=
# Allowed values: development or ad-hoc
STARLIGHT_IOS_EXPORT_METHOD=development
